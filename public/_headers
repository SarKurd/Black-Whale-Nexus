# https://developers.cloudflare.com/workers/static-assets/headers
# https://opennext.js.org/cloudflare/caching#static-assets-caching
/_next/static/*
  Cache-Control: public,max-age=31536000,immutable

# Portraits and manga artwork are stable, unversioned files. Keep them hot in
# the browser while allowing background revalidation when the archive updates.
/portraits/*
  Cache-Control: public,max-age=2592000,stale-while-revalidate=31536000

/images/*
  Cache-Control: public,max-age=2592000,stale-while-revalidate=31536000

# Next exports opengraph-image routes as extensionless PNG files, which
# Cloudflare would otherwise serve without a Content-Type header — social
# scrapers (Twitter/X, WhatsApp) reject images without an image/* type.
/opengraph-image
  Content-Type: image/png
/:section/opengraph-image
  Content-Type: image/png
/:section/:id/opengraph-image
  Content-Type: image/png
