# https://developers.cloudflare.com/workers/static-assets/headers
# https://opennext.js.org/cloudflare/caching#static-assets-caching
/_next/static/*
  Cache-Control: public,max-age=31536000,immutable

# Next exports opengraph-image routes as extensionless PNG files, which
# Cloudflare would otherwise serve without a Content-Type header — social
# scrapers (Twitter/X, WhatsApp) reject images without an image/* type.
/opengraph-image
  Content-Type: image/png
/:section/opengraph-image
  Content-Type: image/png
/:section/:id/opengraph-image
  Content-Type: image/png
