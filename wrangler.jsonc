{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "black-whale-nexus",
  "compatibility_date": "2026-07-23",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "black-whale-nexus.sarbast.dev",
      "custom_domain": true
    }
  ],
  // Static-assets-only Worker: no `main`, so no Worker code runs React per
  // request — Cloudflare serves the exported files directly from the edge.
  // This is what makes the CPU-limit error (1102) impossible.
  "assets": {
    "directory": "./out",
    // Next static export writes `foo.html`; serve it at `/foo`.
    "html_handling": "auto-trailing-slash",
    // Unknown paths fall back to the exported 404 page.
    "not_found_handling": "404-page"
  }
}
